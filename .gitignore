# Dependencies
node_modules/

# Build outputs
dist/
build/
.vite/
*.ts.timestamp-*
vite.config.ts.timestamp-*

# Environment — never commit real keys
.env
.env.*
!.env.example
.env.local
.env.*.local

# Test and evidence artifacts — generated locally, never publish raw runs
artifacts/**
!artifacts/README.md
test-results/
playwright-report/
tests/playwright/artifacts/

# Runtime-created report records (curated seed cases remain tracked)
data/cases/case-[0-9][0-9][0-9][0-9]*.json
# Retained development smoke records created before numeric runtime IDs.
data/cases/case-b1375c822f61f02391.json
data/cases/case-fd42401606ba7d703c.json

# Keep source-controlled placeholders outside the runtime artifact tree
!data/cases/.gitkeep

# TypeScript
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Local RAG embeddings and index cache
data/rag-index/
